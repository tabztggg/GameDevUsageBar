<UserControl x:Class="GameDevUsageBar.App.CompactCardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:GameDevUsageBar.App.Presentation" xmlns:app="clr-namespace:GameDevUsageBar.App" AutomationProperties.Name="{Binding AccessibleText}" Focusable="False" UseLayoutRounding="True">
 <UserControl.Resources>
  <loc:ResetVisibilityConverter x:Key="ResetVisibility"/>
  <Style x:Key="OptionalText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="11"/>
   <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" Padding="16" CornerRadius="10">
  <StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="{Binding IconSource}" Width="20" Height="20" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="18"/><app:AccountPickerView Visibility="{Binding ShowActions, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVisibility}}"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="{Binding Status}"><Ellipse Width="6" Height="6" Fill="{Binding CompactStatusBrush}" Margin="0,0,6,0"/><TextBlock Text="{Binding CompactBadge}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
   </Grid>
   <TextBlock Text="{Binding CompactChannel}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
   <TextBlock Text="{Binding CompactNotice}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource AlertBrush}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock Text="{Binding CompactExplanation}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
   <Border BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,0,0,1" Margin="0,12,0,2"/>
   <ItemsControl ItemsSource="{Binding Metrics}"><ItemsControl.ItemTemplate><DataTemplate>
    <Border BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,0,0,1" Padding="0,10,0,10">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
       <TextBlock Text="{Binding Label}" FontSize="12" TextWrapping="Wrap"/>
       <StackPanel Margin="0,4,0,0">
        <StackPanel.Visibility><MultiBinding Converter="{StaticResource ResetVisibility}"><Binding Path="HasReset"/><Binding Path="ShowReset" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></StackPanel.Visibility>
        <TextBlock Text="{Binding ResetDisplay}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
        <TextBlock Text="{Binding CountdownDisplay}" Style="{StaticResource OptionalText}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
       </StackPanel>
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding Display}" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="160" TextAlignment="Right">
       <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding IsExhausted}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AlertBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
     </Grid>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding CompactTime}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{Binding TimeText}"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding ShowActions, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVisibility}}">
     <Button x:Name="SwitchAccountButton" Content="{loc:Loc 'Switch account'}" ToolTip="{Binding AccountSwitchHint}" IsEnabled="{Binding CanSwitchAccount}" Click="SwitchAccount_Click" FontSize="12" Padding="10,5" Margin="0,0,6,0"/>
     <Button Content="{loc:Loc L0e91610117}" IsEnabled="{Binding CanRefresh}" Click="Refresh_Click" FontSize="12" Padding="10,5" Margin="0,0,6,0"/>
     <Button Content="{Binding SetupLabel}" Click="Setup_Click" FontSize="12" Padding="10,5" Margin="0"/>
    </StackPanel>
   </Grid>
   <Border Visibility="{Binding ShowActions, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVisibility}}">
    <TextBlock Text="{Binding AccountSwitchFeedback}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
   </Border>
  </StackPanel>
 </Border>
</UserControl>
