<Window x:Class="GameDevUsageBar.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:GameDevUsageBar.App.Presentation" xmlns:app="clr-namespace:GameDevUsageBar.App" Style="{StaticResource {x:Type Window}}" Icon="Assets/GameDevUsageBar.ico" Title="GameDevUsageBar" Width="1320" Height="900" MinWidth="740" MinHeight="500" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="OptionalText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="TextWrapping" Value="Wrap"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="HeaderGrid" Margin="0,0,0,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel x:Name="TitleBlock"><StackPanel Orientation="Horizontal"><TextBlock Text="G" FontSize="29" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0"/><TextBlock Text="GameDevUsageBar" FontSize="25" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="OverviewStatus" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,12,0"/></StackPanel>
   <WrapPanel x:Name="HeaderActions" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button x:Name="NetworkOverview" Style="{StaticResource HeaderButton}" Content="{Binding BarValue}" Click="Network_Click"/>
    <ComboBox x:Name="LanguageSelector" SelectedValuePath="Id" Width="94" Margin="0,0,8,0" SelectionChanged="Language_Changed" AutomationProperties.Name="{loc:Loc La4fe65264e}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
    <Button Content="{loc:Loc Lae4dd4887a}" Style="{StaticResource HeaderButton}" Click="Display_Click"/>
    <Button Content="{loc:Loc Lefe79a9c50}" Style="{StaticResource HeaderButton}" Click="Widget_Click"/>
    <Button x:Name="OverviewMore" Content="⋯" Style="{StaticResource HeaderButton}" Click="More_Click" AutomationProperties.Name="{loc:Loc More}">
     <Button.ContextMenu><ContextMenu>
      <MenuItem Header="{loc:Loc Lb4205182f0}" Click="Export_Click"/>
      <MenuItem StaysOpenOnClick="True"><MenuItem.Header><CheckBox x:Name="DemoToggle" Content="{loc:Loc Lee0a671170}" Margin="0" Checked="Demo_Changed" Unchecked="Demo_Changed"/></MenuItem.Header></MenuItem>
      <Separator/><MenuItem Header="{loc:Loc Lfac215487b}" Click="Hide_Click"/><MenuItem Header="{loc:Loc Ld17d84a604}" Click="Exit_Click"/>
     </ContextMenu></Button.ContextMenu>
    </Button>
   </WrapPanel>
  </Grid>
  <TextBlock Grid.Row="1" x:Name="LayoutNotice" Style="{StaticResource OptionalText}" Foreground="{DynamicResource AlertBrush}" FontSize="12" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite"/>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
   <StackPanel x:Name="DashboardHost" SizeChanged="Dashboard_SizeChanged">
    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="FeaturedTitle" Text="{loc:Loc 'Featured modules'}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Content="{loc:Loc L3c128b5436}" Click="RefreshAll_Click" Background="{DynamicResource ActionBrush}" Padding="14,7" Margin="0"/></Grid>
    <ItemsControl x:Name="FeaturedCards" Tag="2" Margin="0,0,-12,4"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><app:OverviewCardView Margin="0,0,12,12" RefreshRequested="Card_Refresh" SetupRequested="Card_Setup"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock x:Name="OtherTitle" Text="{loc:Loc 'Other services'}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <ItemsControl x:Name="Cards" HorizontalContentAlignment="Stretch"><ItemsControl.ItemTemplate><DataTemplate><app:OverviewRowView RefreshRequested="Card_Refresh" SetupRequested="Card_Setup" MoveUpRequested="Card_Up" MoveDownRequested="Card_Down"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock x:Name="EmptyOverview" Text="{loc:Loc 'No enabled services. Configure a service below.'}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8" Visibility="Collapsed"/>
    <Expander x:Name="ConnectionsSection" Header="{loc:Loc 'Other connections'}" Margin="0,16,0,0" HorizontalContentAlignment="Stretch"><ItemsControl x:Name="OtherConnections"><ItemsControl.ItemTemplate><DataTemplate><app:OverviewRowView RefreshRequested="Card_Refresh" SetupRequested="Card_Setup" MoveUpRequested="Card_Up" MoveDownRequested="Card_Down"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{loc:Loc 'Read-only queries'}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Grid.Column="1" Text="v0.9.2" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></Grid>
 </Grid>
</Window>
