<UserControl x:Class="GameDevUsageBar.App.OverviewCardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:GameDevUsageBar.App.Presentation" xmlns:app="clr-namespace:GameDevUsageBar.App" AutomationProperties.Name="{Binding AccessibleText}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" UseLayoutRounding="True" Focusable="False">
 <UserControl.Resources>
  <Style x:Key="OptionalText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="HeaderAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="4,0,0,0"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style x:Key="TinyPercent" TargetType="ProgressBar">
   <Setter Property="Height" Value="3"/><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/><Setter Property="IsHitTestVisible" Value="False"/><Setter Property="Focusable" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
    <Border Background="{DynamicResource EdgeBrush}" CornerRadius="1.5"><Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="1.5"/></Grid></Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="DetailsExpander" TargetType="Expander">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
    <StackPanel>
     <ToggleButton x:Name="DetailsToggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Left" Background="Transparent" Foreground="{DynamicResource MutedBrush}" BorderThickness="0" Padding="0,6,0,6" Cursor="Hand">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><StackPanel Orientation="Horizontal">
       <Path x:Name="Chevron" Data="M 0,0 L 4,4 L 8,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" Width="8" Height="5" Margin="0,0,8,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform Angle="-90"/></Path.RenderTransform></Path>
       <ContentPresenter VerticalAlignment="Center"/>
      </StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="0"/></Setter.Value></Setter></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
      <ContentPresenter Content="{TemplateBinding Header}" TextElement.FontSize="11"/>
     </ToggleButton>
     <ContentPresenter x:Name="DetailsContent" ContentSource="Content" Visibility="Collapsed"/>
    </StackPanel>
    <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="DetailsContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" Padding="18,14" CornerRadius="12">
  <StackPanel>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Image Source="{Binding IconSource}" Width="22" Height="22" Margin="0,0,10,0"/>
     <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" Foreground="{Binding Accent}"/>
     <app:AccountPickerView/>
     <Border Background="{DynamicResource StripHoverBrush}" CornerRadius="4" Padding="7,2" Margin="9,0,0,0" VerticalAlignment="Center"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding PlanLabel}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding PlanLabel}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></Border>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
     <Button x:Name="RefreshButton" Click="Refresh_Click" Style="{StaticResource HeaderAction}" IsEnabled="{Binding CanRefresh}" ToolTip="{loc:Loc L0e91610117}" AutomationProperties.Name="{loc:Loc L0e91610117}"><Path Data="M 11,4 A 5,5 0 1 0 12,9 M 11,1 L 11,4 L 8,4" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.3" Width="13" Height="13" Stretch="Uniform"/></Button>
     <Button x:Name="SetupButton" Click="Setup_Click" Style="{StaticResource HeaderAction}" ToolTip="{Binding SetupLabel}" AutomationProperties.Name="{Binding SetupLabel}"><Path Data="M 1,3 L 13,3 M 1,7 L 13,7 M 1,11 L 13,11 M 4,1 L 4,5 M 10,5 L 10,9 M 6,9 L 6,13" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.3" Width="13" Height="13" Stretch="Uniform"/></Button>
    </StackPanel>
   </Grid>
   <TextBlock Text="{Binding CompactChannel}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
   <StackPanel Orientation="Horizontal" Margin="0,7,0,0" ToolTip="{Binding Status}"><Ellipse Width="5" Height="5" Fill="{Binding CompactStatusBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="{Binding CompactBadge}" FontSize="10" Foreground="{Binding CompactStatusBrush}"/></StackPanel>
   <TextBlock Text="{Binding DemoBanner}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource AlertBrush}" FontSize="10" Margin="0,5,0,0"/>
   <TextBlock Text="{Binding CompactNotice}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource AlertBrush}" FontSize="12" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock Text="{Binding CompactExplanation}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/>
   <ItemsControl x:Name="PrimaryMetricsList" ItemsSource="{Binding PrimaryMetrics}" Margin="0,12,0,0">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,12,0"/></Style></ItemsControl.ItemContainerStyle>
    <ItemsControl.ItemTemplate><DataTemplate>
     <StackPanel>
      <TextBlock Text="{Binding Label}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
      <TextBlock Text="{Binding OverviewDisplay}" FontSize="30" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" TextWrapping="Wrap" Margin="0,4,0,5"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding IsExhausted}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AlertBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Foreground="{Binding DataContext.Accent, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource TinyPercent}" Visibility="{Binding HasPercent, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding ResetDisplay}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource MutedBrush}" FontSize="10"/>
      <TextBlock Text="{Binding CountdownDisplay}" Style="{StaticResource OptionalText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
     </StackPanel>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <Border BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,0,0,1" Margin="0,12,0,0"/>
   <Expander x:Name="SecondaryDetailsExpander" Header="{Binding DetailsLabel}" IsExpanded="False" Style="{StaticResource DetailsExpander}" Visibility="{Binding HasSecondaryMetrics, Converter={StaticResource BoolVisibility}}">
    <ItemsControl x:Name="SecondaryMetricsList" ItemsSource="{Binding SecondaryMetrics}"><ItemsControl.ItemTemplate><DataTemplate>
     <Grid Margin="0,5,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding Label}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding ResetDisplay}" Style="{StaticResource OptionalText}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/><TextBlock Text="{Binding CountdownDisplay}" Style="{StaticResource OptionalText}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/></StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding OverviewDisplay}" FontSize="14" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" TextWrapping="Wrap" TextAlignment="Right" MaxWidth="190"/>
     </Grid>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </Expander>
   <TextBlock Text="{Binding CompactTime}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" ToolTip="{Binding TimeText}"/>
  </StackPanel>
 </Border>
</UserControl>
