<Window x:Class="GameDevUsageBar.App.WidgetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:GameDevUsageBar.App.Presentation" Title="{loc:Loc L9c92c71854}" Style="{StaticResource {x:Type Window}}" Width="400" Height="36" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Focusable="False" WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style x:Key="StripButton" TargetType="Button">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="5">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource StripHoverBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="ProviderTemplate">
      <Border Margin="0,0,2,0">
        <Button Style="{StaticResource StripButton}" Height="26" Click="Provider_Click" Tag="{Binding Id}" AutomationProperties.Name="{Binding BarAccessibleText}" ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="20000">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="{Binding IconSource}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBlock FontSize="13" FontFamily="Segoe UI" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource StripTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center"><Run Text="{Binding BarNumber, Mode=OneWay}"/><Run Text="{Binding BarUnit, Mode=OneWay}" Foreground="{DynamicResource StripMutedBrush}"/></TextBlock>
          </StackPanel>
        </Button>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid>
  <Border x:Name="BarBackground" Background="{DynamicResource StripBackgroundBrush}" CornerRadius="7"/>
  <Border x:Name="BarSurface" Background="Transparent" BorderBrush="{DynamicResource StripEdgeBrush}" BorderThickness="1" CornerRadius="7" Padding="5,0">
    <StackPanel x:Name="BarRow" Orientation="Horizontal">
      <Border x:Name="DragHandle" Width="16" Margin="0,0,3,0" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="Drag_Down" MouseMove="Gesture_Move" MouseLeftButtonUp="Gesture_Up" LostMouseCapture="Gesture_Lost" ToolTip="{loc:Loc Lb55f335667}">
        <TextBlock Text="⠿" FontSize="12" Foreground="{DynamicResource StripMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
      </Border>
      <StackPanel x:Name="ValuesRow" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <StackPanel x:Name="Cards" Orientation="Horizontal" />
        <Button x:Name="EmptyMessage" Style="{StaticResource StripButton}" Click="Settings_Click" Visibility="Collapsed" ToolTip="{loc:Loc L75878a8c30}">
          <TextBlock Text="{loc:Loc Lf75d062dd1}" FontSize="12" />
        </Button>
      </StackPanel>
      <Border x:Name="NetworkCell" BorderBrush="{DynamicResource StripEdgeBrush}" BorderThickness="1,0,0,0" Margin="3,0,3,0" Padding="4,0,0,0" Height="22" VerticalAlignment="Center">
       <Button x:Name="NetworkButton" Style="{StaticResource StripButton}" Width="148" Height="22" Click="Network_Click" ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="20000">
        <TextBlock FontSize="13" FontFamily="Segoe UI" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource StripTextBrush}"><Run Text="{Binding BarNumbers, Mode=OneWay}"/><Run Text=" MB/s" Foreground="{DynamicResource StripMutedBrush}"/></TextBlock>
       </Button>
      </Border>
      <Border BorderBrush="{DynamicResource StripEdgeBrush}" BorderThickness="1,0,0,0" Height="22" VerticalAlignment="Center" Padding="4,0,0,0"><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="TopButton" Style="{StaticResource StripButton}" Width="22" Height="24" Padding="4,0" Click="Top_Click" AutomationProperties.Name="{loc:Loc L41035299ac}" ToolTip="{loc:Loc L56130e653e}">
          <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource StripTextBrush}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
            <Path.Data>
              <PathGeometry Figures="M 9,2 L 15,2 Q 16,2 16,3 L 16,4 L 15,4 L 15,9 L 18,12 L 18,14 L 6,14 L 6,12 L 9,9 L 9,4 L 8,4 L 8,3 Q 8,2 9,2 Z M 12,14 L 12,22">
                <PathGeometry.Transform><RotateTransform Angle="45" CenterX="12" CenterY="12"/></PathGeometry.Transform>
              </PathGeometry>
            </Path.Data>
          </Path>
        </Button>
        <Button x:Name="MoreButton" Style="{StaticResource StripButton}" Width="24" Height="24" Click="More_Click" AutomationProperties.Name="{loc:Loc La197919d45}" ToolTip="{loc:Loc L485ad6c7fe}">
          <TextBlock Text="⋯" FontSize="14" />
        </Button>
      </StackPanel></Border>
    </StackPanel>
  </Border>
  </Grid>
</Window>
