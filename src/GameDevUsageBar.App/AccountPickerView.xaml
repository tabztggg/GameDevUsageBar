<UserControl x:Class="GameDevUsageBar.App.AccountPickerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:GameDevUsageBar.App.Presentation" Width="22" Height="20" Margin="6,0,0,0" VerticalAlignment="Center" Focusable="False" UseLayoutRounding="True">
 <UserControl.Style><Style TargetType="UserControl"><Style.Triggers><DataTrigger Binding="{Binding Definition.IsDemo}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></UserControl.Style>
 <ToggleButton x:Name="PickerButton" Click="Picker_Click" Width="22" Height="20" Padding="0" Background="Transparent" Foreground="{DynamicResource MutedBrush}" BorderThickness="0" Cursor="Hand" ToolTip="{loc:Loc 'Choose the displayed account'}" AutomationProperties.Name="{loc:Loc Accounts}">
  <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="PickerBackground" Background="{TemplateBinding Background}" CornerRadius="4"><Path Data="M 0,0 L 5,5 L 10,0" Width="10" Height="6" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PickerBackground" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PickerBackground" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="PickerBackground" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
 </ToggleButton>
</UserControl>
