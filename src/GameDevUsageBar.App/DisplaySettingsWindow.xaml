<Window x:Class="GameDevUsageBar.App.DisplaySettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:GameDevUsageBar.App.Presentation" Title="{loc:Loc L25549eadf9}" Style="{StaticResource {x:Type Window}}" Width="580" Height="760" MinWidth="480" MinHeight="420" WindowStartupLocation="CenterOwner">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="{loc:Loc Lae4dd4887a}" FontSize="24" FontWeight="SemiBold"/>
   <TextBlock Text="{loc:Loc Lb9af56d9e4}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8"/>
   <TextBlock x:Name="Notice" TextWrapping="Wrap" Foreground="{DynamicResource AlertBrush}" AutomationProperties.LiveSetting="Polite"/>
   <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,10,0,12">
    <StackPanel>
     <TextBlock x:Name="FeaturedTitle" FontSize="17" FontWeight="SemiBold"/>
     <TextBlock x:Name="FeaturedHint" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,12"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="FeaturedFirstLabel" Margin="0,0,0,5"/>
      <TextBlock x:Name="FeaturedSecondLabel" Grid.Column="2" Margin="0,0,0,5"/>
      <ComboBox x:Name="FeaturedFirstSelector" Grid.Row="1" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="Featured_Changed" MinWidth="150"/>
      <ComboBox x:Name="FeaturedSecondSelector" Grid.Row="1" Grid.Column="2" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="Featured_Changed" MinWidth="150"/>
     </Grid>
     <Button x:Name="FeaturedResetButton" Click="FeaturedReset_Click" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="12,6"/>
    </StackPanel>
   </Border>
   <TextBlock x:Name="OrderTitle" FontSize="17" FontWeight="SemiBold"/>
   <TextBlock x:Name="OrderHint" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,8"/>
   <StackPanel x:Name="OrderChoices" Margin="0,0,0,18"/>
   <Border Height="1" Background="{DynamicResource EdgeBrush}" Margin="0,0,0,10"/>
   <StackPanel Orientation="Horizontal" Margin="0,8"><TextBlock Text="{loc:Loc La4fe65264e}" VerticalAlignment="Center" Margin="10,0,6,0"/><ComboBox x:Name="LanguageSelector" SelectedValuePath="Id" Width="115" Margin="0,4" SelectionChanged="Language_Changed" AutomationProperties.Name="{loc:Loc La4fe65264e}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
   <CheckBox x:Name="StartInTray" Content="{loc:Loc L8ce3db87c2}" Click="Toggle_Click"/>
   <CheckBox x:Name="WidgetVisible" Content="{loc:Loc L9eb3b18f25}" Click="Toggle_Click"/>
   <CheckBox x:Name="WidgetTopmost" Content="{loc:Loc L4f4f949118}" Click="Toggle_Click"/>
   <StackPanel x:Name="TransparencySlot" Margin="10,4,10,8"/>
   <CheckBox x:Name="WidgetLocked" Content="{loc:Loc L29a4f9dab3}" Click="Toggle_Click"/>
   <CheckBox x:Name="ShowNetwork" Click="Toggle_Click"/>
   <TextBlock x:Name="NetworkTitle" Margin="0,8,0,0"/>
   <ComboBox x:Name="NetworkSelector" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="Network_Changed" Margin="0,6,0,8"/>
   <TextBlock x:Name="NetworkHint" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
   <TextBlock Text="{loc:Loc L0c1d38d2ca}" FontWeight="SemiBold" Margin="0,12,0,5"/>
   <CheckBox x:Name="AutomaticCards" Content="{loc:Loc L81b60c3d63}" Click="Selection_Click"/>
   <StackPanel x:Name="CardChoices"/>
   <TextBlock Text="{loc:Loc L68ccb10462}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8"/>
   <Button Content="{loc:Loc Leecfebda71}" Click="Position_Click" HorizontalAlignment="Left"/>
   <Button Content="{loc:Loc L77e46358b9}" Click="Reset_Click" HorizontalAlignment="Left"/>
  </StackPanel></ScrollViewer>
  <Button Grid.Row="1" Content="{loc:Loc L7d9eb7acb1}" Click="Close_Click" HorizontalAlignment="Right" Margin="0,10,0,0"/>
 </Grid>
</Window>
