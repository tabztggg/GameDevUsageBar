<UserControl x:Class="GameDevUsageBar.App.OverviewRowView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:GameDevUsageBar.App.Presentation" xmlns:app="clr-namespace:GameDevUsageBar.App" AutomationProperties.Name="{Binding AccessibleText}" SizeChanged="Row_SizeChanged">
 <UserControl.Resources>
  <Style x:Key="RowAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="7,5"/><Setter Property="Margin" Value="0,0,5,0"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="OptionalText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="TextWrapping" Value="Wrap"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
 </UserControl.Resources>
 <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,7">
  <StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid x:Name="RowContent" Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel x:Name="SourcePanel" Margin="0,0,16,0"><StackPanel Orientation="Horizontal"><Image Source="{Binding IconSource}" Width="22" Height="22" Margin="0,0,10,0"/><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><app:AccountPickerView/><TextBlock Text="{Binding PlanLabel}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock Text="{Binding CompactChannel}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="32,3,0,0"/></StackPanel>
     <ItemsControl x:Name="RowMetrics" Grid.Column="1" ItemsSource="{Binding PrimaryMetrics}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,18,0"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxWidth="250"/><TextBlock Text="{Binding OverviewDisplay}" FontSize="18" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" TextWrapping="Wrap" MaxWidth="250"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </Grid>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"><Ellipse Width="6" Height="6" Fill="{Binding CompactStatusBrush}" Margin="0,0,6,0"/><TextBlock Text="{Binding CompactBadge}" Foreground="{DynamicResource MutedBrush}" FontSize="11" ToolTip="{Binding Status}"/></StackPanel>
     <WrapPanel HorizontalAlignment="Right"><Button x:Name="RefreshButton" Content="⟳" Style="{StaticResource RowAction}" IsEnabled="{Binding CanRefresh}" Tag="{Binding Id}" Click="Refresh_Click" ToolTip="{loc:Loc L0e91610117}" AutomationProperties.Name="{loc:Loc L0e91610117}"/><Button x:Name="SetupButton" Content="{Binding SetupLabel}" Style="{StaticResource RowAction}" Tag="{Binding Id}" Click="Setup_Click"/><Button Content="↑" Style="{StaticResource RowAction}" Tag="{Binding Id}" Click="Up_Click" ToolTip="{loc:Loc L736612d4d0}" AutomationProperties.Name="{loc:Loc Lf936334b02}"/><Button Content="↓" Style="{StaticResource RowAction}" Tag="{Binding Id}" Click="Down_Click" ToolTip="{loc:Loc Ld6e856081e}" AutomationProperties.Name="{loc:Loc L6598a80989}"/><Button Content="{loc:Loc Details}" Style="{StaticResource RowAction}" Click="Details_Click"/></WrapPanel>
    </StackPanel>
   </Grid>
   <TextBlock Text="{Binding CompactNotice}" Style="{StaticResource OptionalText}" FontSize="12" Foreground="{DynamicResource AlertBrush}" Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite"/>
   <app:CompactCardView x:Name="ExpandedDetails" Visibility="Collapsed" Margin="0,10,0,0" ShowActions="False"/>
  </StackPanel>
 </Border>
</UserControl>
