<Window x:Class="GameDevUsageBar.App.AccountsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:GameDevUsageBar.App.Presentation" Style="{StaticResource {x:Type Window}}" Title="{loc:Loc 'Manage accounts'}" Width="650" Height="740" MinWidth="520" MinHeight="500" WindowStartupLocation="CenterOwner">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14"><TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{loc:Loc 'Each account keeps its own credentials, usage and retry state. Choosing a displayed account does not change the CLI login.'}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/></StackPanel>
  <ListBox x:Name="AccountList" Grid.Row="1" SelectionChanged="Account_Changed" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{loc:Loc Accounts}">
   <ListBox.Template><ControlTemplate TargetType="{x:Type ListBox}"><ScrollViewer Focusable="False" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate></ListBox.Template>
   <ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,6"><StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding State.Config.Label}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,10,0"/><TextBlock Grid.Column="1" Text="{loc:Loc 'Current account'}" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Visibility="{Binding State.Config.IsActive,Converter={StaticResource BoolVisibility}}"/></Grid>
    <TextBlock Text="{Binding PrimarySummary}" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="{Binding CompactBadge}" Foreground="{Binding CompactStatusBrush}" FontSize="11" Margin="0,5,0,0"/><TextBlock Text="{Binding CompactNotice}" Foreground="{DynamicResource AlertBrush}" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding CompactTime}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
   </StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <StackPanel Grid.Row="2" Margin="0,12,0,0">
   <WrapPanel x:Name="SelectedActions"><Button x:Name="SelectButton" Content="{loc:Loc 'Show this account'}" Click="Select_Click"/><Button x:Name="EditButton" Content="{loc:Loc 'Edit account'}" Click="Edit_Click"/><Button x:Name="RefreshButton" Content="{loc:Loc Refresh}" Click="Refresh_Click"/><Button x:Name="DeleteButton" Content="{loc:Loc 'Delete account'}" Click="Delete_Click"/></WrapPanel>
   <TextBlock x:Name="AccountNameLabel" Text="{loc:Loc 'Account name (required)'}" Visibility="Collapsed" FontSize="12" Margin="0,10,0,0"/>
   <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="NewLabel" MaxLength="60" TabIndex="10" Margin="0,0,8,0" ToolTip="{loc:Loc 'New account label (optional)'}" AutomationProperties.Name="{loc:Loc 'New account label (optional)'}"/><Button x:Name="AddButton" Grid.Column="1" TabIndex="11" Content="{loc:Loc 'Add account'}" Click="Add_Click"/></Grid>
   <Border x:Name="NativeActions" Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="12" Margin="0,10,0,0"><StackPanel><TextBlock x:Name="NativeIntro" Text="{loc:Loc 'Sign in to each account in the CLI yourself, then save its current login here. Saved logins are encrypted for this Windows user.'}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/><WrapPanel Margin="0,8,0,0"><Button x:Name="LoginButton" TabIndex="12" Content="{loc:Loc 'Sign in to this account'}" Visibility="Collapsed" Click="Login_Click"/><Button x:Name="CaptureButton" TabIndex="13" Content="{loc:Loc 'Save current CLI login'}" Click="Capture_Click"/><Button x:Name="SwitchButton" TabIndex="14" Content="{loc:Loc 'Switch CLI login'}" Click="Switch_Click"/></WrapPanel><TextBlock x:Name="NativeBoundary" Text="{loc:Loc 'CLI switching changes only its auth file. Close CLI sessions first. Existing desktop sessions are not restarted or changed.'}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel></Border>
   <TextBlock x:Name="Feedback" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AlertBrush}" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
 </Grid>
</Window>
