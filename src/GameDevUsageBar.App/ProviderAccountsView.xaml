<UserControl x:Class="GameDevUsageBar.App.ProviderAccountsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:GameDevUsageBar.App.Presentation" xmlns:local="clr-namespace:GameDevUsageBar.App" UseLayoutRounding="True" Focusable="False">
 <StackPanel>
  <Grid Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="{Binding IconSource}" Width="17" Height="17" Margin="0,0,7,0"/><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"/></StackPanel>
   <Button Grid.Column="1" Content="{loc:Loc 'Manage accounts'}" FontSize="10" Padding="7,4" Margin="12,0,0,0" Click="Manage_Click" Visibility="{Binding ShowActions, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVisibility}}"/>
  </Grid>
  <TextBlock x:Name="EmptyAccounts" Text="{loc:Loc 'No saved accounts'}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,10"/>
  <ItemsControl x:Name="Accounts"><ItemsControl.ItemTemplate><DataTemplate><local:CompactAccountView ShowActions="{Binding ShowActions, RelativeSource={RelativeSource AncestorType=local:ProviderAccountsView}}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <TextBlock x:Name="HoverHint" Text="{loc:Loc 'Click to open account actions'}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
 </StackPanel>
</UserControl>
